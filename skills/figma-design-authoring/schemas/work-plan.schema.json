{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlmux.local/schemas/figma-work-plan-v2.json",
  "title": "Figma progressive work plan with obligation ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "objective", "terminalTruth", "state", "contextPolicy", "representationPolicy", "obligations", "nodes", "edges", "frontier", "notesPath"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "planId": { "$ref": "#/$defs/id" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 500 },
    "terminalTruth": { "type": "string", "minLength": 1, "maxLength": 500 },
    "state": { "enum": ["ACTIVE", "PASS", "FAIL", "BLOCKED"] },
    "contextPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxActiveDeepResources", "noteAfterEachLoad", "distillBeforeNextLoad"],
      "properties": {
        "mode": { "const": "progressive" },
        "maxActiveDeepResources": { "type": "integer", "minimum": 1, "maximum": 2 },
        "noteAfterEachLoad": { "const": true },
        "distillBeforeNextLoad": { "const": true }
      }
    },
    "representationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rules"],
      "properties": {
        "default": { "$ref": "#/$defs/visual" },
        "rules": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shape", "use"],
            "properties": {
              "shape": { "type": "string", "minLength": 1, "maxLength": 64 },
              "use": { "$ref": "#/$defs/visual" }
            }
          }
        }
      }
    },
    "obligations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/obligation" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "frontier": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "notesPath": { "type": "string", "minLength": 1, "maxLength": 260 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "actor": {
      "enum": [
        "engineering-planning", "figma-code-connect", "figma-code-to-design", "figma-components",
        "figma-design-authoring", "figma-design-system", "figma-design-to-code", "figma-design-to-design",
        "figma-layout", "figma-motion", "figma-native", "figma-prototype", "figma-scene", "figma-tokens",
        "figma-typography", "figma-verification", "figma-visual-system", "frontend-engineering",
        "plugin-runtime", "skill-plugin-engineering"
      ]
    },
    "status": { "enum": ["PENDING", "ACTIVE", "PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "visual": { "enum": ["text", "table", "flow", "timeline", "tree", "state-diagram", "typed-graph", "bar", "metric-cards", "wireframe", "component-specimen"] },
    "evidenceRefs": {
      "type": "array",
      "description": "Project-local evidence paths. The work-plan validator resolves every PASS reference against its evidence base directory and rejects missing paths.",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceText", "required", "owner", "proofRequired", "status", "evidenceRefs", "blocker"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/actor" },
        "proofRequired": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "blocker": { "type": "string", "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
          "then": { "properties": { "blocker": { "minLength": 1 } } },
          "else": { "properties": { "blocker": { "maxLength": 0 } } }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "outcome", "status", "owner", "specialists", "obligationIds", "dependsOn", "entrypoint", "proof", "evidenceRefs", "nonGoals", "recovery"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["FOUNDATION", "WALKING_SKELETON", "VERTICAL_SLICE", "HARDENING", "VERIFICATION"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "$ref": "#/$defs/status" },
        "owner": { "$ref": "#/$defs/actor" },
        "specialists": { "type": "array", "items": { "$ref": "#/$defs/actor" }, "uniqueItems": true },
        "obligationIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 300 },
        "proof": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "recovery": { "type": "string", "minLength": 1, "maxLength": 500 },
        "blocker": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
          "then": { "required": ["blocker"] }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "relation", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "relation": { "enum": ["BLOCKS_TRUTH", "PROVED_BY", "INVALIDATES", "CONFLICTS_WRITE_WITH"] },
        "to": { "$ref": "#/$defs/id" }
      }
    }
  }
}
