{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlmux.local/schemas/figma-work-plan-v3.json",
  "title": "Figma semantic work plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "objective", "terminalTruth", "state", "nodes", "edges", "frontier", "notesPath"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "planId": { "$ref": "#/$defs/id" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 500 },
    "terminalTruth": { "type": "string", "minLength": 1, "maxLength": 500 },
    "state": { "enum": ["ACTIVE", "PASS", "FAIL", "BLOCKED"] },
    "obligations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/obligation" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "frontier": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "notesPath": { "type": "string", "minLength": 1, "maxLength": 260 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "status": { "enum": ["PENDING", "ACTIVE", "PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "evidenceRefs": {
      "type": "array",
      "description": "Project-local evidence paths. When the obligation ledger is present, PASS nodes and PASS obligations require existing evidence refs.",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceText", "required", "proofRequired", "status", "evidenceRefs", "blocker"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "proofRequired": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "blocker": { "type": "string", "maxLength": 500 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "outcome", "status", "dependsOn", "entrypoint", "proof", "nonGoals", "recovery"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["FOUNDATION", "WALKING_SKELETON", "VERTICAL_SLICE", "HARDENING", "VERIFICATION"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "$ref": "#/$defs/status" },
        "obligationIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 300 },
        "proof": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "recovery": { "type": "string", "minLength": 1, "maxLength": 500 },
        "blocker": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "relation", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "relation": { "enum": ["BLOCKS_TRUTH", "PROVED_BY", "INVALIDATES", "CONFLICTS_WRITE_WITH"] },
        "to": { "$ref": "#/$defs/id" }
      }
    }
  }
}
