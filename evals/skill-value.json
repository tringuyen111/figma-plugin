        "mode/scope behavior unclear",
        "consumer blast radius unclear"
      ],
      "outputPacket": [
        "token roles/identities",
        "collection/mode/alias/scope decisions",
        "consumer/migration impact",
        "system proof"
      ],
      "ioFocus": [
        "filter variable subsets",
        "load all modes only when decision spans them"
      ]
    },
    {
      "owner": "figma-typography",
      "decisionDelta": "Treat typography as information role plus geometry, including font/fallback metrics, measure, numeric behavior, localization, and text pressure.",
      "minimumInputs": [
        "information role",
        "representative real strings",
        "current style/font/bindings",
        "material pressure"
      ],
      "escalateWhen": [
