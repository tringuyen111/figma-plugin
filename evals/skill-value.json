{
  "schemaVersion": 1,
  "status": "FROZEN_NOT_RUN",
  "principle": {
    "ordering": [
      "capability-quality",
      "proof-correctness",
      "io-fitness"
    ],
    "rule": "I/O efficiency may break ties or improve a non-regressing capability, but must never compensate for weaker decisions, artifacts, recovery, or proof.",
    "skillContextSize": "diagnostic-only",
    "optimize": "task evidence/tool input-output, retries, payloads, and latency after capability quality is preserved"
  },
  "comparisonArms": [
    {
      "id": "BASE_SAME_TOOLS",
      "description": "Base agent with the same tool/provider availability, without ControlMux Figma domain Skills."
    },
    {
      "id": "OFFICIAL_FIGMA_SAME_TOOLS",
      "description": "Current official/installed Figma Skill guidance with the same tool/provider availability."
    },
    {
      "id": "CONTROLMUX_SAME_TOOLS",
      "description": "ControlMux Figma Skill with the same tool/provider availability; isolates ControlMux decision-method value."
    },
    {
      "id": "CONTROLMUX_HYBRID",
      "description": "ControlMux Figma Skill with live structured Figma provider delegation plus local ControlMux execution where appropriate; target production posture."
    }
  ],
  "capabilityMetrics": [
    "primary-owner-correctness",
    "decision-correctness",
    "near-miss-discrimination",
    "failure-diagnosis-and-reentry",
    "artifact-or-verdict-quality",
    "proof-dimension-correctness",
    "false-pass-rate",
    "unresolved-truth-honesty"
  ],
  "ioMetrics": [
    "evidence-input-tokens",
    "result-output-tokens",
    "tool-call-count",
    "provider-call-count",
    "local-figma-exec-count",
    "retry-count",
    "evidence-escalation-count",
    "bridge-request-bytes",
    "bridge-response-bytes",
    "queue-ms",
    "execution-ms",
    "total-ms"
  ],
  "diagnosticOnlyMetrics": [
    "activated-skill-context-tokens",
    "loaded-reference-context-tokens"
  ],
  "cases": [
    {
      "owner": "figma-native",
      "decisionDelta": "Resolve exact runtime/editor/page/API boundary and return bounded native evidence rather than treating arbitrary JavaScript execution as the capability.",
      "minimumInputs": [
        "target/runtime identity",
        "bounded native operation",
        "expected postcondition"
      ],
      "escalateWhen": [
        "target ambiguous",
        "API/editor support uncertain",
        "visible/binary proof required"
      ],
      "outputPacket": [
        "target",
        "result-or-error",
        "affected-ids",
        "warnings",
        "proof"
      ],
      "ioFocus": [
        "bounded return projection",
        "maxOutputChars",
        "retry attribution",
        "queue-vs-execution latency"
      ]
    },
    {
      "owner": "figma-scene",
      "decisionDelta": "Separate semantic nesting, structural ownership, silhouette, clipping, and 2.5D plane relations to fix the causal owner rather than the visible symptom.",
      "minimumInputs": [
        "exact region",
        "local parent-child bounds",
        "material plane/clipping relations"
      ],
      "escalateWhen": [
        "owner lies outside local subtree",
        "perceptual depth/occlusion claim needs render"
      ],
      "outputPacket": [
        "selected owner/representation",
        "causal relation",
        "affected-ids",
        "structure proof",
        "visual proof when material"
      ],
      "ioFocus": [
        "local subtree first",
        "render only at relevant scale"
      ]
    },
    {
      "owner": "figma-layout",
      "decisionDelta": "Choose layout relation and invariant under pressure before selecting Auto Layout/Grid/sizing properties.",
      "minimumInputs": [
        "layout owner",
        "representative children/content",
        "current layout/sizing properties",
        "pressure condition"
      ],
      "escalateWhen": [
        "parent sizing context required",
        "component/token contract affects geometry",
        "rendered pressure proof required"
      ],
      "outputPacket": [
        "relation",
        "sizing/adaptation rule",
        "affected-ids/properties",
        "pressure proof"
      ],
      "ioFocus": [
        "targeted geometry",
        "avoid unrelated style/file inventory"
      ]
    },
    {
      "owner": "figma-tokens",
      "decisionDelta": "Classify token identity by semantic role, modes, aliases, scopes, consumers, and propagation rather than repeated raw values.",
      "minimumInputs": [
        "material collections/modes/variables",
        "representative consumers",
        "naming/code authority when needed"
