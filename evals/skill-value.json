        "pressure proof"
      ],
      "ioFocus": [
        "font/style subset only",
        "representative consumer before full inventory"
      ]
    },
    {
      "owner": "figma-visual-system",
      "decisionDelta": "Separate semantic visual roles from contextual perception across area, repetition, backdrop, hue/lightness/chroma, material, and depth cues.",
      "minimumInputs": [
        "exact rendered region/state",
        "feeding tokens/styles/effects",
        "backdrop context"
